# Production Environment Variables Template
# Copy this to .env.production and fill with actual production values
# NEVER commit .env.production to version control!

# Database Configuration - Use your production database
POSTGRES_DB=your_production_db
POSTGRES_USER=your_production_user
POSTGRES_PASSWORD=your_secure_production_password
POSTGRES_PORT=5432

# Backend Configuration
NODE_ENV=production
BACKEND_PORT=5000
CORS_ORIGIN=https://your-production-domain.com

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=https://api.your-production-domain.com/api
