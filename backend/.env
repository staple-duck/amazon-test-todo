# In a real production environment:
# 1. Remove this file from git: git rm --cached backend/.env
# 2. Add .env back to .gitignore
# 3. Use secure environment variables (Vercel, Railway, AWS Secrets Manager, etc.)
# 4. Never commit production credentials to version control!

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# For Docker: use service name 'postgres'
DATABASE_URL=postgresql://todouser:todopass@postgres:5432/todoapp
# For local development: use localhost
# DATABASE_URL=postgresql://todouser:todopass@localhost:5432/todoapp

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
